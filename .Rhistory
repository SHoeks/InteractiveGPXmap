tracks_simple = st_simplify(tracks, dTolerance = 100)
mapview(tracks,col.region="red") + mapview(track_points,col.region="orange")
mapview(tracks,col.region="red",color="red") +
mapview(track_points,col.region="orange") +
mapview(track_points,col.region="red")
